# Password to secure the Tiller web UI
# If set, this takes priority over any password stored in the database.
# For Docker deployments, set this in your docker-compose.yml or as an environment variable.
TILLER_PASSWORD=your-secure-password

# SQLite database path (defaults to ./data/tiller.db)
# In Docker the volume is mounted at /app/data, so this should be /app/data/tiller.db
TILLER_DB_PATH=./data/tiller.db